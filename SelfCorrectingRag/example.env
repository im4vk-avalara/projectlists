# AIOS Environment Variables
# Copy this file to .env and fill in your values

# ==== ALFA (LLM Proxy) - RECOMMENDED ====
# Get your ALFA_CLAIM from Alfa onboarding
ALFA_CLAIM=your-project-uuid-here
ALFA_ENV=qa

# ==== OpenAI (Direct) ====
# Only needed if using OpenAI backend directly instead of Alfa
# OPENAI_API_KEY=sk-your-key-here

# HuggingFace Token (optional, for gated models)
# HUGGINGFACE_TOKEN=hf_your_token_here

# AIOS Settings
AIOS_LOG_LEVEL=INFO
AIOS_HOST=0.0.0.0
AIOS_PORT=8000

# Development settings
AIOS_DEBUG=false
AIOS_RELOAD=false

