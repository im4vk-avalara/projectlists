// Factorial computation in ToyLang
// Demonstrates functions and recursion

fn factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn main() {
    print("Factorials:");
    
    let i = 0;
    while (i <= 10) {
        print(i, "! =", factorial(i));
        i = i + 1;
    }
}
