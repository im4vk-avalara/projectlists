// Fibonacci sequence in ToyLang
// Demonstrates recursion and control flow

fn fib(n) {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    print("Fibonacci sequence:");
    
    let i = 0;
    while (i < 15) {
        print("fib(", i, ") =", fib(i));
        i = i + 1;
    }
}
