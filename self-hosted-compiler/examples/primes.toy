// Prime number checker in ToyLang
// Demonstrates loops, conditionals, and modulo operator

fn is_prime(n) {
    if (n <= 1) {
        return 0;
    }
    if (n <= 3) {
        return 1;
    }
    if (n % 2 == 0) {
        return 0;
    }
    
    let i = 3;
    while (i * i <= n) {
        if (n % i == 0) {
            return 0;
        }
        i = i + 2;
    }
    return 1;
}

fn main() {
    print("Prime numbers up to 50:");
    
    let n = 2;
    while (n <= 50) {
        if (is_prime(n)) {
            print(n);
        }
        n = n + 1;
    }
}
