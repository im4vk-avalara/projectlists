// ============================================================
// ToyCC1 - A ToyLang Compiler Written in ToyLang0 (Fixed Version)
// ============================================================
// This is Stage 1 of the self-hosted compiler.
// Compiles ToyLang0 source code to C code.
//
// Input: ToyLang0 source from stdin
// Output: C code to stdout
// ============================================================

// ============================================================
// CHARACTER UTILITIES  
// ============================================================

fn is_digit(c) {
    return c >= 48 && c <= 57;
}

fn is_alpha(c) {
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

fn is_alnum(c) {
    return is_digit(c) || is_alpha(c);
}

fn is_space(c) {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

// ============================================================
// GLOBAL STATE - stored as return values from "state" functions
// We use a trick: pass state through function parameters
// ============================================================

fn read_char() {
    return getchar();
}

// Global state to track if we're in expression context (where / means division)
// 0 = statement context (// means comment), 1 = expression context (/ means division)
fn skip_ws(ch) {
    while (ch != 0 - 1 && is_space(ch)) {
        ch = read_char();
    }
    return ch;
}

// Skip whitespace and comments - used when we know division isn't expected
fn skip_ws_comments(ch) {
    ch = skip_ws(ch);
    while (ch == 47) {  // '/'
        let ch2 = read_char();
        if (ch2 == 47) {  // '//' - comment, skip to end of line
            while (ch != 10 && ch != 0 - 1) {
                ch = read_char();
            }
            if (ch == 10) {
                ch = read_char();
            }
            ch = skip_ws(ch);  // Continue skipping whitespace after comment
        } else {
            // Not a comment - this is an error in statement context
            // Return the ch2 (the char after /)
            return ch2;
        }
    }
    return ch;
}

// ============================================================
// OUTPUT HELPERS
// ============================================================

fn emit_int(n) {
    if (n < 0) {
        putchar(45);
        n = 0 - n;
    }
    if (n >= 10) {
        emit_int(n / 10);
    }
    putchar(48 + n % 10);
}

fn nl() { putchar(10); }
fn sp() { putchar(32); }
fn indent(n) { let i = 0; while (i < n) { sp(); sp(); sp(); sp(); i = i + 1; } }

// Emit fixed strings
fn emit_int64() { putchar(105); putchar(110); putchar(116); putchar(54); putchar(52); putchar(95); putchar(116); }
fn emit_void() { putchar(118); putchar(111); putchar(105); putchar(100); }
fn emit_return() { putchar(114); putchar(101); putchar(116); putchar(117); putchar(114); putchar(110); }
fn emit_if() { putchar(105); putchar(102); }
fn emit_else() { putchar(101); putchar(108); putchar(115); putchar(101); }
fn emit_while() { putchar(119); putchar(104); putchar(105); putchar(108); putchar(101); }
fn emit_printf() { putchar(112); putchar(114); putchar(105); putchar(110); putchar(116); putchar(102); }
fn emit_fn_() { putchar(102); putchar(110); putchar(95); }
fn emit_toy_putchar() { putchar(116); putchar(111); putchar(121); putchar(95); putchar(112); putchar(117); putchar(116); putchar(99); putchar(104); putchar(97); putchar(114); }
fn emit_toy_getchar() { putchar(116); putchar(111); putchar(121); putchar(95); putchar(103); putchar(101); putchar(116); putchar(99); putchar(104); putchar(97); putchar(114); }

// ============================================================
// IDENTIFIER BUFFER (max 31 chars)
// We store identifier chars in individual variables
// ============================================================

fn store_id_char(idx, ch, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15) {
    // Return updated tuple - but we can't in ToyLang0
    // So we use a different approach - emit as we go but with prefix
    return 0;
}

// Read identifier into buffer and return (length * 1000000 + first_char * 1000 + last_char_or_zero)
// Actually, let's use a simpler approach: read and emit with buffering for fn_ decision

// ============================================================
// HEADER OUTPUT
// ============================================================

fn emit_header() {
    // /* Generated by ToyCC1 */
    putchar(47); putchar(42); sp();
    putchar(71); putchar(101); putchar(110); putchar(101); putchar(114); putchar(97); putchar(116); putchar(101); putchar(100);
    sp(); putchar(98); putchar(121); sp();
    putchar(84); putchar(111); putchar(121); putchar(67); putchar(67); putchar(49);
    sp(); putchar(42); putchar(47); nl();
    
    // #include <stdio.h>
    putchar(35); putchar(105); putchar(110); putchar(99); putchar(108); putchar(117); putchar(100); putchar(101); sp();
    putchar(60); putchar(115); putchar(116); putchar(100); putchar(105); putchar(111); putchar(46); putchar(104); putchar(62); nl();
    
    // #include <stdint.h>
    putchar(35); putchar(105); putchar(110); putchar(99); putchar(108); putchar(117); putchar(100); putchar(101); sp();
    putchar(60); putchar(115); putchar(116); putchar(100); putchar(105); putchar(110); putchar(116); putchar(46); putchar(104); putchar(62); nl();
    nl();
    
    // static int64_t toy_putchar(int64_t c) { putchar((int)c); return 0; }
    putchar(115); putchar(116); putchar(97); putchar(116); putchar(105); putchar(99); sp(); emit_int64(); sp();
    emit_toy_putchar(); putchar(40); emit_int64(); sp(); putchar(99); putchar(41); sp();
    putchar(123); sp(); putchar(112); putchar(117); putchar(116); putchar(99); putchar(104); putchar(97); putchar(114);
    putchar(40); putchar(40); putchar(105); putchar(110); putchar(116); putchar(41); putchar(99); putchar(41); putchar(59);
    sp(); emit_return(); sp(); putchar(48); putchar(59); sp(); putchar(125); nl();
    
    // static int64_t toy_getchar(void) { return getchar(); }
    putchar(115); putchar(116); putchar(97); putchar(116); putchar(105); putchar(99); sp(); emit_int64(); sp();
    emit_toy_getchar(); putchar(40); emit_void(); putchar(41); sp();
    putchar(123); sp(); emit_return(); sp();
    putchar(103); putchar(101); putchar(116); putchar(99); putchar(104); putchar(97); putchar(114);
    putchar(40); putchar(41); putchar(59); sp(); putchar(125); nl();
    nl();
}

fn emit_main_entry() {
    // int main(void) { return (int)fn_main(); }
    putchar(105); putchar(110); putchar(116); sp(); putchar(109); putchar(97); putchar(105); putchar(110);
    putchar(40); emit_void(); putchar(41); sp(); putchar(123); sp();
    emit_return(); sp(); putchar(40); putchar(105); putchar(110); putchar(116); putchar(41);
    emit_fn_(); putchar(109); putchar(97); putchar(105); putchar(110);
    putchar(40); putchar(41); putchar(59); sp(); putchar(125); nl();
}

// ============================================================
// MAIN COMPILER LOGIC
// ============================================================

fn compile(ch) {
    emit_header();
    
    ch = skip_ws_comments(ch);
    while (ch != 0 - 1) {
        if (ch == 102) {  // 'f' for 'fn'
            ch = compile_fn(ch);
        } else {
            ch = read_char();
        }
        ch = skip_ws_comments(ch);
    }
    
    emit_main_entry();
    return 0;
}

fn compile_fn(ch) {
    // Skip 'fn'
    ch = read_char();  // 'n'
    ch = read_char();
    ch = skip_ws(ch);
    
    // Output: int64_t fn_
    emit_int64(); sp(); emit_fn_();
    
    // Output function name
    while (is_alnum(ch)) {
        putchar(ch);
        ch = read_char();
    }
    
    ch = skip_ws(ch);
    
    // Parameters
    putchar(40);  // '('
    ch = read_char();  // skip '('
    ch = skip_ws(ch);
    
    let first = 1;
    while (ch != 41) {  // ')'
        if (!first) {
            putchar(44); sp();  // ', '
        }
        emit_int64(); sp();
        while (is_alnum(ch)) {
            putchar(ch);
            ch = read_char();
        }
        ch = skip_ws(ch);
        if (ch == 44) {  // ','
            ch = read_char();
            ch = skip_ws(ch);
        }
        first = 0;
    }
    
    if (first) {
        emit_void();
    }
    
    putchar(41);  // ')'
    ch = read_char();  // skip ')'
    ch = skip_ws(ch);
    
    // Body
    sp(); putchar(123); nl();  // ' {\n'
    ch = read_char();  // skip '{'
    
    ch = compile_block(ch, 1);
    
    // Default return
    indent(1); emit_return(); sp(); putchar(48); putchar(59); nl();
    putchar(125); nl(); nl();  // '}\n\n'
    
    return ch;
}

fn compile_block(ch, ind) {
    ch = skip_ws_comments(ch);
    while (ch != 125 && ch != 0 - 1) {  // '}'
        ch = compile_stmt(ch, ind);
        ch = skip_ws_comments(ch);
    }
    if (ch == 125) {
        ch = read_char();
    }
    return ch;
}

fn compile_stmt(ch, ind) {
    ch = skip_ws_comments(ch);
    
    if (ch == 123) {  // '{'
        indent(ind); putchar(123); nl();
        ch = read_char();
        ch = compile_block(ch, ind + 1);
        indent(ind); putchar(125); nl();
        return ch;
    }
    
    // Read identifier into buffer to check for keywords
    if (!is_alpha(ch)) {
        // Not an identifier, skip
        ch = read_char();
        return ch;
    }
    
    // Read identifier (up to 24 chars for function names)
    let c0 = ch; ch = read_char();
    let c1 = 0; let c2 = 0; let c3 = 0; let c4 = 0; let c5 = 0;
    let c6 = 0; let c7 = 0; let c8 = 0; let c9 = 0; let c10 = 0;
    let c11 = 0; let c12 = 0; let c13 = 0; let c14 = 0; let c15 = 0;
    let c16 = 0; let c17 = 0; let c18 = 0; let c19 = 0; let c20 = 0;
    let c21 = 0; let c22 = 0; let c23 = 0;
    let len = 1;
    
    if (is_alnum(ch)) { c1 = ch; len = 2; ch = read_char(); }
    if (is_alnum(ch)) { c2 = ch; len = 3; ch = read_char(); }
    if (is_alnum(ch)) { c3 = ch; len = 4; ch = read_char(); }
    if (is_alnum(ch)) { c4 = ch; len = 5; ch = read_char(); }
    if (is_alnum(ch)) { c5 = ch; len = 6; ch = read_char(); }
    if (is_alnum(ch)) { c6 = ch; len = 7; ch = read_char(); }
    if (is_alnum(ch)) { c7 = ch; len = 8; ch = read_char(); }
    if (is_alnum(ch)) { c8 = ch; len = 9; ch = read_char(); }
    if (is_alnum(ch)) { c9 = ch; len = 10; ch = read_char(); }
    if (is_alnum(ch)) { c10 = ch; len = 11; ch = read_char(); }
    if (is_alnum(ch)) { c11 = ch; len = 12; ch = read_char(); }
    if (is_alnum(ch)) { c12 = ch; len = 13; ch = read_char(); }
    if (is_alnum(ch)) { c13 = ch; len = 14; ch = read_char(); }
    if (is_alnum(ch)) { c14 = ch; len = 15; ch = read_char(); }
    if (is_alnum(ch)) { c15 = ch; len = 16; ch = read_char(); }
    if (is_alnum(ch)) { c16 = ch; len = 17; ch = read_char(); }
    if (is_alnum(ch)) { c17 = ch; len = 18; ch = read_char(); }
    if (is_alnum(ch)) { c18 = ch; len = 19; ch = read_char(); }
    if (is_alnum(ch)) { c19 = ch; len = 20; ch = read_char(); }
    if (is_alnum(ch)) { c20 = ch; len = 21; ch = read_char(); }
    if (is_alnum(ch)) { c21 = ch; len = 22; ch = read_char(); }
    if (is_alnum(ch)) { c22 = ch; len = 23; ch = read_char(); }
    if (is_alnum(ch)) { c23 = ch; len = 24; ch = read_char(); }
    while (is_alnum(ch)) { ch = read_char(); }
    
    // Check for keywords (all under 8 chars)
    if (len == 3 && c0 == 108 && c1 == 101 && c2 == 116) {
        return compile_let_body(ch, ind);
    }
    if (len == 2 && c0 == 105 && c1 == 102) {
        return compile_if_body(ch, ind);
    }
    if (len == 5 && c0 == 119 && c1 == 104 && c2 == 105 && c3 == 108 && c4 == 101) {
        return compile_while_body(ch, ind);
    }
    if (len == 6 && c0 == 114 && c1 == 101 && c2 == 116 && c3 == 117 && c4 == 114 && c5 == 110) {
        return compile_return_body(ch, ind);
    }
    if (len == 5 && c0 == 112 && c1 == 114 && c2 == 105 && c3 == 110 && c4 == 116) {
        return compile_print_body(ch, ind);
    }
    
    // Check for built-in functions: putchar, getchar
    // putchar = 112,117,116,99,104,97,114 (7 chars)
    let is_putchar = len == 7 && c0 == 112 && c1 == 117 && c2 == 116 && c3 == 99 && c4 == 104 && c5 == 97 && c6 == 114;
    // getchar = 103,101,116,99,104,97,114 (7 chars)
    let is_getchar = len == 7 && c0 == 103 && c1 == 101 && c2 == 116 && c3 == 99 && c4 == 104 && c5 == 97 && c6 == 114;
    
    // Not a keyword - it's an identifier (assignment or function call)
    ch = skip_ws(ch);
    indent(ind);
    
    // Handle built-ins or add fn_ prefix for user functions
    if (ch == 40) {
        if (is_putchar) {
            emit_toy_putchar();
            ch = compile_call_args(ch);
            putchar(59); nl();
            ch = skip_ws(ch);
            if (ch == 59) { ch = read_char(); }
            return ch;
        }
        if (is_getchar) {
            emit_toy_getchar();
            ch = compile_call_args(ch);
            putchar(59); nl();
            ch = skip_ws(ch);
            if (ch == 59) { ch = read_char(); }
            return ch;
        }
        emit_fn_();
    }
    
    // Output identifier
    putchar(c0);
    if (len >= 2) { putchar(c1); }
    if (len >= 3) { putchar(c2); }
    if (len >= 4) { putchar(c3); }
    if (len >= 5) { putchar(c4); }
    if (len >= 6) { putchar(c5); }
    if (len >= 7) { putchar(c6); }
    if (len >= 8) { putchar(c7); }
    if (len >= 9) { putchar(c8); }
    if (len >= 10) { putchar(c9); }
    if (len >= 11) { putchar(c10); }
    if (len >= 12) { putchar(c11); }
    if (len >= 13) { putchar(c12); }
    if (len >= 14) { putchar(c13); }
    if (len >= 15) { putchar(c14); }
    if (len >= 16) { putchar(c15); }
    if (len >= 17) { putchar(c16); }
    if (len >= 18) { putchar(c17); }
    if (len >= 19) { putchar(c18); }
    if (len >= 20) { putchar(c19); }
    if (len >= 21) { putchar(c20); }
    if (len >= 22) { putchar(c21); }
    if (len >= 23) { putchar(c22); }
    if (len >= 24) { putchar(c23); }
    
    if (ch == 61) {  // '=' - assignment
        sp(); putchar(61); sp();
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_expr(ch);
    } else if (ch == 40) {  // '(' - function call
        ch = compile_call_args(ch);
    }
    
    putchar(59); nl();
    ch = skip_ws(ch);
    if (ch == 59) { ch = read_char(); }
    
    return ch;
}

fn compile_let_body(ch, ind) {
    // 'let' already consumed, ch is first char after
    ch = skip_ws(ch);
    
    indent(ind); emit_int64(); sp();
    
    // Variable name
    while (is_alnum(ch)) {
        putchar(ch);
        ch = read_char();
    }
    
    ch = skip_ws(ch);
    sp(); putchar(61); sp();  // ' = '
    ch = read_char();  // skip '='
    ch = skip_ws(ch);
    
    ch = compile_expr(ch);
    
    putchar(59); nl();
    
    ch = skip_ws(ch);
    if (ch == 59) { ch = read_char(); }
    
    return ch;
}

fn compile_if_body(ch, ind) {
    // 'if' already consumed, ch is first char after
    ch = skip_ws(ch);
    
    indent(ind); emit_if(); sp(); putchar(40);
    ch = read_char();  // skip '('
    ch = skip_ws(ch);
    
    ch = compile_expr(ch);
    
    putchar(41);  // ')'
    ch = skip_ws(ch);
    if (ch == 41) { ch = read_char(); }
    ch = skip_ws(ch);
    
    sp(); putchar(123); nl();
    ch = read_char();  // skip '{'
    ch = compile_block(ch, ind + 1);
    indent(ind); putchar(125);
    
    // Check for 'else' by peeking ahead
    // We need to be careful not to consume chars if it's not else
    ch = skip_ws_comments(ch);
    
    // Only check if first char is 'e' (101)
    if (ch == 101) {
        // Read chars to check for "else" or buffer identifier
        let c1 = read_char();
        let c2 = 0;
        let c3 = 0;
        let c4 = 0;
        let is_else = 0;
        
        // Always read c2, c3, c4 if available (for identifier buffering)
        if (is_alnum(c1)) {
            c2 = read_char();
            if (is_alnum(c2)) {
                c3 = read_char();
                if (is_alnum(c3)) {
                    c4 = read_char();
                }
            }
        }
        
        // Check if it's exactly "else"
        if (c1 == 108 && c2 == 115 && c3 == 101 && !is_alnum(c4)) {
            is_else = 1;
            ch = c4;  // next char after "else"
        }
        
        if (is_else) {
            ch = skip_ws_comments(ch);
            sp(); emit_else();
            
            // Check for 'else if'
            if (ch == 105) {  // 'i'
                let i1 = read_char();
                if (i1 == 102) {  // 'f'
                    let i2 = read_char();
                    if (!is_alnum(i2)) {
                        sp();
                        ch = skip_ws_comments(i2);
                        return compile_if_body(ch, 0);
                    }
                }
            }
            
            // else block
            sp(); putchar(123); nl();
            ch = read_char();  // skip '{'
            ch = compile_block(ch, ind + 1);
            indent(ind); putchar(125);
        } else {
            // NOT else - we've consumed chars for an identifier starting with 'e'
            // We have: 'e' (101), c1, c2, c3, and c4 (if it was checked)
            // Build up the full identifier
            let id0 = 101;  // 'e'
            let id1 = c1;
            let id2 = c2;
            let id3 = c3;
            let id4 = c4;
            let id5 = 0; let id6 = 0; let id7 = 0; let id8 = 0; let id9 = 0;
            let id10 = 0; let id11 = 0; let id12 = 0; let id13 = 0; let id14 = 0;
            let id_len = 1;
            
            // Count how many of c1,c2,c3,c4 are valid alnum
            if (is_alnum(c1)) { id_len = 2; }
            if (is_alnum(c2)) { id_len = 3; }
            if (is_alnum(c3)) { id_len = 4; }
            if (is_alnum(c4)) { id_len = 5; }
            
            // Determine which char to continue from
            if (id_len == 1) { ch = c1; }
            else if (id_len == 2) { ch = c2; }
            else if (id_len == 3) { ch = c3; }
            else if (id_len == 4) { ch = c4; }
            else { ch = read_char(); }
            
            // Continue reading identifier
            if (is_alnum(ch)) { id5 = ch; id_len = 6; ch = read_char(); }
            if (is_alnum(ch)) { id6 = ch; id_len = 7; ch = read_char(); }
            if (is_alnum(ch)) { id7 = ch; id_len = 8; ch = read_char(); }
            if (is_alnum(ch)) { id8 = ch; id_len = 9; ch = read_char(); }
            if (is_alnum(ch)) { id9 = ch; id_len = 10; ch = read_char(); }
            if (is_alnum(ch)) { id10 = ch; id_len = 11; ch = read_char(); }
            if (is_alnum(ch)) { id11 = ch; id_len = 12; ch = read_char(); }
            if (is_alnum(ch)) { id12 = ch; id_len = 13; ch = read_char(); }
            if (is_alnum(ch)) { id13 = ch; id_len = 14; ch = read_char(); }
            if (is_alnum(ch)) { id14 = ch; id_len = 15; ch = read_char(); }
            while (is_alnum(ch)) { ch = read_char(); }  // Skip excess
            
            ch = skip_ws(ch);
            nl();
            indent(ind);
            
            // Check if it's a function call and add fn_ prefix
            if (ch == 40) {
                emit_fn_();
            }
            
            // Output the identifier
            putchar(id0);
            if (id_len >= 2) { putchar(id1); }
            if (id_len >= 3) { putchar(id2); }
            if (id_len >= 4) { putchar(id3); }
            if (id_len >= 5) { putchar(id4); }
            if (id_len >= 6) { putchar(id5); }
            if (id_len >= 7) { putchar(id6); }
            if (id_len >= 8) { putchar(id7); }
            if (id_len >= 9) { putchar(id8); }
            if (id_len >= 10) { putchar(id9); }
            if (id_len >= 11) { putchar(id10); }
            if (id_len >= 12) { putchar(id11); }
            if (id_len >= 13) { putchar(id12); }
            if (id_len >= 14) { putchar(id13); }
            if (id_len >= 15) { putchar(id14); }
            
            // Handle rest of statement
            if (ch == 61) {  // '=' - assignment
                sp(); putchar(61); sp();
                ch = read_char();
                ch = skip_ws(ch);
                ch = compile_expr(ch);
            } else if (ch == 40) {  // '(' - function call
                ch = compile_call_args(ch);
            }
            putchar(59); nl();
            ch = skip_ws(ch);
            if (ch == 59) { ch = read_char(); }
        }
    }
    
    nl();
    return ch;
}

fn compile_while_body(ch, ind) {
    // 'while' already consumed, ch is first char after
    ch = skip_ws(ch);
    
    indent(ind); emit_while(); sp(); putchar(40);
    ch = read_char();  // skip '('
    ch = skip_ws(ch);
    
    ch = compile_expr(ch);
    
    putchar(41);
    ch = skip_ws(ch);
    if (ch == 41) { ch = read_char(); }
    ch = skip_ws(ch);
    
    sp(); putchar(123); nl();
    ch = read_char();  // skip '{'
    ch = compile_block(ch, ind + 1);
    indent(ind); putchar(125); nl();
    
    return ch;
}

fn compile_return_body(ch, ind) {
    // 'return' already consumed, ch is first char after
    ch = skip_ws(ch);
    
    indent(ind); emit_return(); sp();
    
    if (ch != 59) {
        ch = compile_expr(ch);
    } else {
        putchar(48);
    }
    
    putchar(59); nl();
    
    ch = skip_ws(ch);
    if (ch == 59) { ch = read_char(); }
    
    return ch;
}

fn compile_print_body(ch, ind) {
    // 'print' already consumed, ch is first char after
    ch = skip_ws(ch);
    if (ch == 40) {
        ch = read_char();  // skip '('
    }
    ch = skip_ws(ch);
    
    // Handle each argument with a separate printf
    while (ch != 41 && ch != 0 - 1) {  // ')' or EOF
        ch = skip_ws(ch);
        
        // Check again in case we've hit ')'
        if (ch == 41) {
            ch = read_char();
            return ch;
        }
        
        indent(ind);
        
        if (ch == 34) {  // String literal
            emit_printf(); putchar(40); putchar(34);  // printf("
            ch = read_char();
            while (ch != 34 && ch != 0 - 1) {
                if (ch == 92) {  // backslash
                    ch = read_char();
                    if (ch == 110) { putchar(92); putchar(110); }
                    else if (ch == 116) { putchar(92); putchar(116); }
                    else if (ch == 34) { putchar(92); putchar(34); }
                    else if (ch == 92) { putchar(92); putchar(92); }
                    else { putchar(ch); }
                } else {
                    putchar(ch);
                }
                ch = read_char();
            }
            ch = read_char();  // skip closing "
            putchar(34); putchar(41); putchar(59); nl();  // ");\n
        } else {
            // Expression - output as printf("%lld", (long long)(expr))
            let ch_before = ch;
            emit_printf(); putchar(40); putchar(34);  // printf("
            putchar(37); putchar(108); putchar(108); putchar(100);  // %lld
            putchar(34); putchar(44); sp();  // ", 
            // Cast to long long
            putchar(40); putchar(108); putchar(111); putchar(110); putchar(103);  // (long
            sp(); putchar(108); putchar(111); putchar(110); putchar(103); putchar(41);  // long)
            putchar(40);  // (
            ch = compile_expr(ch);
            putchar(41); putchar(41); putchar(59); nl();  // ));\n
            
            // Safety check: if ch didn't change, consume one char to avoid infinite loop
            if (ch == ch_before && ch != 41 && ch != 44) {
                ch = read_char();
            }
        }
        
        ch = skip_ws(ch);
        if (ch == 44) {  // ','
            ch = read_char();
            ch = skip_ws(ch);
        }
    }
    
    // Print newline at end
    indent(ind);
    emit_printf(); putchar(40); putchar(34);
    putchar(92); putchar(110);  // \n
    putchar(34); putchar(41); putchar(59); nl();  // ");\n
    
    if (ch == 41) { ch = read_char(); }
    ch = skip_ws(ch);
    if (ch == 59) { ch = read_char(); }
    
    return ch;
}

fn compile_assign_or_expr(ch, ind) {
    indent(ind);
    
    // Read identifier
    while (is_alnum(ch)) {
        putchar(ch);
        ch = read_char();
    }
    
    ch = skip_ws(ch);
    
    if (ch == 61) {  // '='
        sp(); putchar(61); sp();
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_expr(ch);
    } else if (ch == 40) {  // '(' - function call
        ch = compile_call_args(ch);
    }
    
    putchar(59); nl();
    
    ch = skip_ws(ch);
    if (ch == 59) { ch = read_char(); }
    
    return ch;
}

fn compile_call_args(ch) {
    putchar(40);
    ch = read_char();  // skip '('
    ch = skip_ws(ch);
    
    let first = 1;
    while (ch != 41 && ch != 0 - 1) {
        if (!first) {
            putchar(44); sp();
        }
        ch = compile_expr(ch);
        first = 0;
        ch = skip_ws(ch);
        if (ch == 44) {
            ch = read_char();
            ch = skip_ws(ch);
        }
    }
    
    putchar(41);
    if (ch == 41) { ch = read_char(); }
    
    return ch;
}

// ============================================================
// EXPRESSION COMPILER
// ============================================================

fn compile_expr(ch) {
    return compile_or(ch);
}

fn compile_or(ch) {
    ch = compile_and(ch);
    ch = skip_ws(ch);
    
    while (ch == 124) {  // '|'
        let ch2 = read_char();
        if (ch2 == 124) {
            sp(); putchar(124); putchar(124); sp();
            ch = read_char();
            ch = skip_ws(ch);
            ch = compile_and(ch);
            ch = skip_ws(ch);
        } else {
            putchar(124);
            ch = ch2;
            return ch;
        }
    }
    return ch;
}

fn compile_and(ch) {
    ch = compile_eq(ch);
    ch = skip_ws(ch);
    
    while (ch == 38) {  // '&'
        let ch2 = read_char();
        if (ch2 == 38) {
            sp(); putchar(38); putchar(38); sp();
            ch = read_char();
            ch = skip_ws(ch);
            ch = compile_eq(ch);
            ch = skip_ws(ch);
        } else {
            putchar(38);
            ch = ch2;
            return ch;
        }
    }
    return ch;
}

fn compile_eq(ch) {
    ch = compile_cmp(ch);
    ch = skip_ws(ch);
    
    while (ch == 61 || ch == 33) {  // '=' or '!'
        let op = ch;
        let ch2 = read_char();
        if (ch2 == 61) {  // '==' or '!='
            sp(); putchar(op); putchar(61); sp();
            ch = read_char();
            ch = skip_ws(ch);
            ch = compile_cmp(ch);
            ch = skip_ws(ch);
        } else {
            if (op == 61) {
                // Single '=' - end of expression (assignment context)
                return ch;
            }
            // '!' without '=' - unary not handled elsewhere
            putchar(op);
            ch = ch2;
            return ch;
        }
    }
    return ch;
}

fn compile_cmp(ch) {
    ch = compile_term(ch);
    ch = skip_ws(ch);
    
    while (ch == 60 || ch == 62) {  // '<' or '>'
        let op = ch;
        let ch2 = read_char();
        sp(); putchar(op);
        if (ch2 == 61) {
            putchar(61);
            ch = read_char();
        } else {
            ch = ch2;
        }
        sp();
        ch = skip_ws(ch);
        ch = compile_term(ch);
        ch = skip_ws(ch);
    }
    return ch;
}

fn compile_term(ch) {
    ch = compile_factor(ch);
    ch = skip_ws(ch);
    
    while (ch == 43 || ch == 45) {  // '+' or '-'
        let op = ch;
        sp(); putchar(op); sp();
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_factor(ch);
        ch = skip_ws(ch);
    }
    return ch;
}

fn compile_factor(ch) {
    ch = compile_unary(ch);
    ch = skip_ws(ch);
    
    while (ch == 42 || ch == 47 || ch == 37) {  // '*' '/' '%'
        let op = ch;
        sp(); putchar(op); sp();
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_unary(ch);
        ch = skip_ws(ch);
    }
    return ch;
}

fn compile_unary(ch) {
    ch = skip_ws(ch);
    
    if (ch == 45) {  // '-'
        putchar(45);
        ch = read_char();
        return compile_unary(ch);
    }
    if (ch == 33) {  // '!'
        putchar(33);
        ch = read_char();
        return compile_unary(ch);
    }
    
    return compile_primary(ch);
}

fn compile_primary(ch) {
    ch = skip_ws(ch);
    
    // Number
    if (is_digit(ch)) {
        while (is_digit(ch)) {
            putchar(ch);
            ch = read_char();
        }
        return ch;
    }
    
    // Parenthesized expression
    if (ch == 40) {  // '('
        putchar(40);
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_expr(ch);
        ch = skip_ws(ch);
        putchar(41);
        if (ch == 41) { ch = read_char(); }
        return ch;
    }
    
    // Identifier, keyword, or function call
    if (is_alpha(ch)) {
        // Store first char
        let c0 = ch;
        ch = read_char();
        
        // Check for 'true' - t=116, r=114, u=117, e=101
        if (c0 == 116 && ch == 114) {
            let c2 = read_char();
            let c3 = read_char();
            if (c2 == 117 && c3 == 101) {
                ch = read_char();
                putchar(49);  // '1'
                return ch;
            }
            // Not 'true', output what we have
            putchar(c0); putchar(ch); putchar(c2); putchar(c3);
            ch = read_char();
            while (is_alnum(ch)) { putchar(ch); ch = read_char(); }
            return ch;
        }
        
        // Check for 'false' - f=102, a=97, l=108, s=115, e=101
        if (c0 == 102 && ch == 97) {
            let f2 = read_char();
            let f3 = read_char();
            let f4 = read_char();
            if (f2 == 108 && f3 == 115 && f4 == 101) {
                ch = read_char();
                putchar(48);  // '0'
                return ch;
            }
            // Not 'false', output as identifier
            putchar(c0); putchar(ch); putchar(f2); putchar(f3); putchar(f4);
            ch = read_char();
            while (is_alnum(ch)) { putchar(ch); ch = read_char(); }
            return ch;
        }
        
        // Check for 'putchar' - p=112, u=117
        if (c0 == 112 && ch == 117) {
            // Skip 'tchar'
            ch = read_char(); ch = read_char(); ch = read_char(); ch = read_char(); ch = read_char();
            ch = skip_ws(ch);
            emit_toy_putchar();
            ch = compile_call_args(ch);
            return ch;
        }
        
        // Check for 'getchar' - g=103, e=101
        if (c0 == 103 && ch == 101) {
            // Skip 'tchar'
            ch = read_char(); ch = read_char(); ch = read_char(); ch = read_char(); ch = read_char();
            ch = skip_ws(ch);
            emit_toy_getchar();
            putchar(40); putchar(41);  // '()'
            ch = read_char(); ch = read_char();  // skip '()'
            return ch;
        }
        
        // Store identifier chars in buffer (up to 32 chars)
        let id0 = c0; let id1 = 0; let id2 = 0; let id3 = 0;
        let id4 = 0; let id5 = 0; let id6 = 0; let id7 = 0;
        let id8 = 0; let id9 = 0; let id10 = 0; let id11 = 0;
        let id12 = 0; let id13 = 0; let id14 = 0; let id15 = 0;
        let id16 = 0; let id17 = 0; let id18 = 0; let id19 = 0;
        let id20 = 0; let id21 = 0; let id22 = 0; let id23 = 0;
        let len = 1;
        
        // Read rest of identifier
        if (is_alnum(ch)) { id1 = ch; len = 2; ch = read_char(); }
        if (is_alnum(ch)) { id2 = ch; len = 3; ch = read_char(); }
        if (is_alnum(ch)) { id3 = ch; len = 4; ch = read_char(); }
        if (is_alnum(ch)) { id4 = ch; len = 5; ch = read_char(); }
        if (is_alnum(ch)) { id5 = ch; len = 6; ch = read_char(); }
        if (is_alnum(ch)) { id6 = ch; len = 7; ch = read_char(); }
        if (is_alnum(ch)) { id7 = ch; len = 8; ch = read_char(); }
        if (is_alnum(ch)) { id8 = ch; len = 9; ch = read_char(); }
        if (is_alnum(ch)) { id9 = ch; len = 10; ch = read_char(); }
        if (is_alnum(ch)) { id10 = ch; len = 11; ch = read_char(); }
        if (is_alnum(ch)) { id11 = ch; len = 12; ch = read_char(); }
        if (is_alnum(ch)) { id12 = ch; len = 13; ch = read_char(); }
        if (is_alnum(ch)) { id13 = ch; len = 14; ch = read_char(); }
        if (is_alnum(ch)) { id14 = ch; len = 15; ch = read_char(); }
        if (is_alnum(ch)) { id15 = ch; len = 16; ch = read_char(); }
        if (is_alnum(ch)) { id16 = ch; len = 17; ch = read_char(); }
        if (is_alnum(ch)) { id17 = ch; len = 18; ch = read_char(); }
        if (is_alnum(ch)) { id18 = ch; len = 19; ch = read_char(); }
        if (is_alnum(ch)) { id19 = ch; len = 20; ch = read_char(); }
        if (is_alnum(ch)) { id20 = ch; len = 21; ch = read_char(); }
        if (is_alnum(ch)) { id21 = ch; len = 22; ch = read_char(); }
        if (is_alnum(ch)) { id22 = ch; len = 23; ch = read_char(); }
        if (is_alnum(ch)) { id23 = ch; len = 24; ch = read_char(); }
        // Skip any remaining chars (identifiers > 24 chars truncated)
        while (is_alnum(ch)) { ch = read_char(); }
        
        ch = skip_ws(ch);
        
        // Check if function call - add fn_ prefix
        if (ch == 40) {
            emit_fn_();
        }
        
        // Output identifier
        putchar(id0);
        if (len >= 2) { putchar(id1); }
        if (len >= 3) { putchar(id2); }
        if (len >= 4) { putchar(id3); }
        if (len >= 5) { putchar(id4); }
        if (len >= 6) { putchar(id5); }
        if (len >= 7) { putchar(id6); }
        if (len >= 8) { putchar(id7); }
        if (len >= 9) { putchar(id8); }
        if (len >= 10) { putchar(id9); }
        if (len >= 11) { putchar(id10); }
        if (len >= 12) { putchar(id11); }
        if (len >= 13) { putchar(id12); }
        if (len >= 14) { putchar(id13); }
        if (len >= 15) { putchar(id14); }
        if (len >= 16) { putchar(id15); }
        if (len >= 17) { putchar(id16); }
        if (len >= 18) { putchar(id17); }
        if (len >= 19) { putchar(id18); }
        if (len >= 20) { putchar(id19); }
        if (len >= 21) { putchar(id20); }
        if (len >= 22) { putchar(id21); }
        if (len >= 23) { putchar(id22); }
        if (len >= 24) { putchar(id23); }
        
        // Handle function call
        if (ch == 40) {
            ch = compile_call_args(ch);
        }
        
        return ch;
    }
    
    return ch;
}

// ============================================================
// MAIN
// ============================================================

fn main() {
    let ch = read_char();
    return compile(ch);
}
