// ============================================================
// ToyCC2 - Full ToyLang Compiler
// ============================================================
// This is Stage 2 of the self-hosted compiler.
// ToyCC2 is an enhanced version of ToyCC1 that supports
// full ToyLang (though still within ToyLang0 limitations).
//
// The key difference: ToyCC2 can be compiled by ToyCC1,
// and then ToyCC2 can compile itself (self-hosting!).
//
// Input: ToyLang source from stdin
// Output: C code to stdout
// ============================================================

// ============================================================
// CHARACTER UTILITIES
// ============================================================

fn is_digit(c) {
    return c >= 48 && c <= 57;
}

fn is_alpha(c) {
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

fn is_alnum(c) {
    return is_digit(c) || is_alpha(c);
}

fn is_space(c) {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

// ============================================================
// OUTPUT UTILITIES
// ============================================================

fn emit_char(c) {
    putchar(c);
}

fn emit_newline() {
    putchar(10);
}

fn emit_space() {
    putchar(32);
}

fn emit_indent(level) {
    let i = 0;
    while (i < level) {
        emit_space();
        emit_space();
        emit_space();
        emit_space();
        i = i + 1;
    }
}

fn emit_int(n) {
    if (n < 0) {
        putchar(45);
        n = 0 - n;
    }
    if (n >= 10) {
        emit_int(n / 10);
    }
    putchar(48 + n % 10);
}

// Emit "int64_t"
fn emit_int64() {
    putchar(105); putchar(110); putchar(116);
    putchar(54); putchar(52); putchar(95); putchar(116);
}

// Emit "void"
fn emit_void() {
    putchar(118); putchar(111); putchar(105); putchar(100);
}

// Emit "if"
fn emit_if_kw() {
    putchar(105); putchar(102);
}

// Emit "else"
fn emit_else_kw() {
    putchar(101); putchar(108); putchar(115); putchar(101);
}

// Emit "while"
fn emit_while_kw() {
    putchar(119); putchar(104); putchar(105); putchar(108); putchar(101);
}

// Emit "return"
fn emit_return_kw() {
    putchar(114); putchar(101); putchar(116);
    putchar(117); putchar(114); putchar(110);
}

// Emit "printf"
fn emit_printf() {
    putchar(112); putchar(114); putchar(105);
    putchar(110); putchar(116); putchar(102);
}

// Emit "fn_"
fn emit_fn_prefix() {
    putchar(102); putchar(110); putchar(95);
}

// Emit "toy_putchar"
fn emit_toy_putchar() {
    putchar(116); putchar(111); putchar(121); putchar(95);
    putchar(112); putchar(117); putchar(116); putchar(99);
    putchar(104); putchar(97); putchar(114);
}

// Emit "toy_getchar"
fn emit_toy_getchar() {
    putchar(116); putchar(111); putchar(121); putchar(95);
    putchar(103); putchar(101); putchar(116); putchar(99);
    putchar(104); putchar(97); putchar(114);
}

fn emit_lparen() { putchar(40); }
fn emit_rparen() { putchar(41); }
fn emit_lbrace() { putchar(123); }
fn emit_rbrace() { putchar(125); }
fn emit_semi() { putchar(59); }
fn emit_comma() { putchar(44); }
fn emit_assign() { putchar(61); }
fn emit_quote() { putchar(34); }

// ============================================================
// LEXER
// ============================================================

fn read_char() {
    return getchar();
}

fn skip_ws(ch) {
    while (is_space(ch)) {
        ch = read_char();
    }
    // Handle comments
    if (ch == 47) {
        let ch2 = read_char();
        if (ch2 == 47) {
            while (ch != 10 && ch != 0 - 1) {
                ch = read_char();
            }
            if (ch == 10) {
                ch = read_char();
            }
            return skip_ws(ch);
        } else {
            // Division operator - need to handle
            // Return special marker
            return 0 - 1000 - ch2;  // Encode pending char
        }
    }
    return ch;
}

// ============================================================
// C HEADER GENERATION
// ============================================================

fn emit_header() {
    // /* Generated by ToyCC2 */
    putchar(47); putchar(42); putchar(32);
    putchar(71); putchar(101); putchar(110); putchar(101);
    putchar(114); putchar(97); putchar(116); putchar(101);
    putchar(100); putchar(32); putchar(98); putchar(121);
    putchar(32); putchar(84); putchar(111); putchar(121);
    putchar(67); putchar(67); putchar(50); putchar(32);
    putchar(42); putchar(47);
    emit_newline();
    
    // #include <stdio.h>
    putchar(35); putchar(105); putchar(110); putchar(99);
    putchar(108); putchar(117); putchar(100); putchar(101);
    emit_space();
    putchar(60); putchar(115); putchar(116); putchar(100);
    putchar(105); putchar(111); putchar(46); putchar(104);
    putchar(62);
    emit_newline();
    
    // #include <stdint.h>
    putchar(35); putchar(105); putchar(110); putchar(99);
    putchar(108); putchar(117); putchar(100); putchar(101);
    emit_space();
    putchar(60); putchar(115); putchar(116); putchar(100);
    putchar(105); putchar(110); putchar(116); putchar(46);
    putchar(104); putchar(62);
    emit_newline();
    emit_newline();
    
    // static int64_t toy_putchar(int64_t c) { putchar((int)c); return 0; }
    putchar(115); putchar(116); putchar(97); putchar(116);
    putchar(105); putchar(99); emit_space();
    emit_int64(); emit_space();
    emit_toy_putchar();
    emit_lparen(); emit_int64(); emit_space();
    putchar(99); emit_rparen(); emit_space();
    emit_lbrace(); emit_space();
    putchar(112); putchar(117); putchar(116); putchar(99);
    putchar(104); putchar(97); putchar(114);
    emit_lparen(); emit_lparen();
    putchar(105); putchar(110); putchar(116);
    emit_rparen(); putchar(99); emit_rparen();
    emit_semi(); emit_space();
    emit_return_kw(); emit_space();
    putchar(48); emit_semi(); emit_space();
    emit_rbrace();
    emit_newline();
    
    // static int64_t toy_getchar(void) { return getchar(); }
    putchar(115); putchar(116); putchar(97); putchar(116);
    putchar(105); putchar(99); emit_space();
    emit_int64(); emit_space();
    emit_toy_getchar();
    emit_lparen(); emit_void(); emit_rparen();
    emit_space(); emit_lbrace(); emit_space();
    emit_return_kw(); emit_space();
    putchar(103); putchar(101); putchar(116); putchar(99);
    putchar(104); putchar(97); putchar(114);
    emit_lparen(); emit_rparen(); emit_semi();
    emit_space(); emit_rbrace();
    emit_newline();
    emit_newline();
}

fn emit_main_wrapper() {
    // int main(void) { return (int)fn_main(); }
    putchar(105); putchar(110); putchar(116);
    emit_space();
    putchar(109); putchar(97); putchar(105); putchar(110);
    emit_lparen(); emit_void(); emit_rparen();
    emit_space(); emit_lbrace(); emit_space();
    emit_return_kw(); emit_space();
    emit_lparen();
    putchar(105); putchar(110); putchar(116);
    emit_rparen();
    emit_fn_prefix();
    putchar(109); putchar(97); putchar(105); putchar(110);
    emit_lparen(); emit_rparen(); emit_semi();
    emit_space(); emit_rbrace();
    emit_newline();
}

// ============================================================
// COMPILER CORE
// ============================================================

fn compile_program(ch) {
    emit_header();
    
    ch = skip_ws(ch);
    while (ch != 0 - 1) {
        if (ch == 102) {  // 'f' for 'fn'
            ch = compile_function(ch);
        } else {
            ch = read_char();
        }
        ch = skip_ws(ch);
    }
    
    emit_main_wrapper();
    return 0;
}

fn compile_function(ch) {
    // Skip 'fn'
    ch = read_char();  // 'n'
    ch = read_char();
    ch = skip_ws(ch);
    
    // Output function signature
    emit_int64();
    emit_space();
    emit_fn_prefix();
    
    // Read and emit function name
    while (is_alnum(ch)) {
        putchar(ch);
        ch = read_char();
    }
    
    ch = skip_ws(ch);
    emit_lparen();
    ch = read_char();  // Skip '('
    ch = skip_ws(ch);
    
    // Parameters
    let first = 1;
    while (ch != 41) {  // ')'
        if (!first) {
            emit_comma();
            emit_space();
        }
        emit_int64();
        emit_space();
        while (is_alnum(ch)) {
            putchar(ch);
            ch = read_char();
        }
        ch = skip_ws(ch);
        if (ch == 44) {  // ','
            ch = read_char();
            ch = skip_ws(ch);
        }
        first = 0;
    }
    
    if (first) {
        emit_void();
    }
    
    emit_rparen();
    ch = read_char();  // Skip ')'
    ch = skip_ws(ch);
    
    // Body
    emit_space();
    emit_lbrace();
    emit_newline();
    ch = read_char();  // Skip '{'
    
    ch = compile_block(ch, 1);
    
    emit_indent(1);
    emit_return_kw();
    emit_space();
    putchar(48);
    emit_semi();
    emit_newline();
    emit_rbrace();
    emit_newline();
    emit_newline();
    
    return ch;
}

fn compile_block(ch, indent) {
    ch = skip_ws(ch);
    
    while (ch != 125 && ch != 0 - 1) {  // '}'
        ch = compile_stmt(ch, indent);
        ch = skip_ws(ch);
    }
    
    if (ch == 125) {
        ch = read_char();
    }
    
    return ch;
}

fn compile_stmt(ch, indent) {
    ch = skip_ws(ch);
    
    if (ch == 123) {  // '{'
        emit_indent(indent);
        emit_lbrace();
        emit_newline();
        ch = read_char();
        ch = compile_block(ch, indent + 1);
        emit_indent(indent);
        emit_rbrace();
        emit_newline();
        return ch;
    }
    
    // Read identifier to check for keywords
    if (!is_alpha(ch)) {
        ch = read_char();
        return ch;
    }
    
    // Buffer identifier (up to 8 chars for keywords)
    let c0 = ch; ch = read_char();
    let c1 = 0; let c2 = 0; let c3 = 0; let c4 = 0; let c5 = 0;
    let len = 1;
    
    if (is_alnum(ch)) { c1 = ch; len = 2; ch = read_char(); }
    if (is_alnum(ch)) { c2 = ch; len = 3; ch = read_char(); }
    if (is_alnum(ch)) { c3 = ch; len = 4; ch = read_char(); }
    if (is_alnum(ch)) { c4 = ch; len = 5; ch = read_char(); }
    if (is_alnum(ch)) { c5 = ch; len = 6; ch = read_char(); }
    
    // Check for keywords (must match exactly)
    // 'let' = 108,101,116 (len=3)
    if (len == 3 && c0 == 108 && c1 == 101 && c2 == 116) {
        return compile_let_body(ch, indent);
    }
    // 'if' = 105,102 (len=2)
    if (len == 2 && c0 == 105 && c1 == 102) {
        return compile_if_body(ch, indent);
    }
    // 'while' = 119,104,105,108,101 (len=5)
    if (len == 5 && c0 == 119 && c1 == 104 && c2 == 105 && c3 == 108 && c4 == 101) {
        return compile_while_body(ch, indent);
    }
    // 'return' = 114,101,116,117,114,110 (len=6)
    if (len == 6 && c0 == 114 && c1 == 101 && c2 == 116 && c3 == 117 && c4 == 114 && c5 == 110) {
        return compile_return_body(ch, indent);
    }
    // 'print' = 112,114,105,110,116 (len=5)
    if (len == 5 && c0 == 112 && c1 == 114 && c2 == 105 && c3 == 110 && c4 == 116) {
        return compile_print_body(ch, indent);
    }
    
    // Not a keyword - handle as assignment or function call
    // Read rest of identifier
    let c6 = 0; let c7 = 0; let c8 = 0; let c9 = 0;
    let c10 = 0; let c11 = 0; let c12 = 0;
    if (is_alnum(ch)) { c6 = ch; len = 7; ch = read_char(); }
    if (is_alnum(ch)) { c7 = ch; len = 8; ch = read_char(); }
    if (is_alnum(ch)) { c8 = ch; len = 9; ch = read_char(); }
    if (is_alnum(ch)) { c9 = ch; len = 10; ch = read_char(); }
    if (is_alnum(ch)) { c10 = ch; len = 11; ch = read_char(); }
    if (is_alnum(ch)) { c11 = ch; len = 12; ch = read_char(); }
    if (is_alnum(ch)) { c12 = ch; len = 13; ch = read_char(); }
    while (is_alnum(ch)) { ch = read_char(); }
    
    ch = skip_ws(ch);
    emit_indent(indent);
    
    // Add fn_ prefix for function calls
    if (ch == 40) {
        emit_fn_prefix();
    }
    
    // Output identifier
    putchar(c0);
    if (len >= 2) { putchar(c1); }
    if (len >= 3) { putchar(c2); }
    if (len >= 4) { putchar(c3); }
    if (len >= 5) { putchar(c4); }
    if (len >= 6) { putchar(c5); }
    if (len >= 7) { putchar(c6); }
    if (len >= 8) { putchar(c7); }
    if (len >= 9) { putchar(c8); }
    if (len >= 10) { putchar(c9); }
    if (len >= 11) { putchar(c10); }
    if (len >= 12) { putchar(c11); }
    if (len >= 13) { putchar(c12); }
    
    if (ch == 61) {  // '=' assignment
        emit_space();
        emit_assign();
        emit_space();
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_expr(ch);
    } else if (ch == 40) {  // '(' function call
        ch = compile_call_args(ch);
    }
    
    emit_semi();
    emit_newline();
    ch = skip_ws(ch);
    if (ch == 59) { ch = read_char(); }
    return ch;
}

fn compile_let_body(ch, indent) {
    // 'let' already consumed, ch is first char after
    ch = skip_ws(ch);
    
    emit_indent(indent);
    emit_int64();
    emit_space();
    
    while (is_alnum(ch)) {
        putchar(ch);
        ch = read_char();
    }
    
    ch = skip_ws(ch);
    emit_space();
    emit_assign();
    emit_space();
    
    ch = read_char();  // Skip '='
    ch = skip_ws(ch);
    
    ch = compile_expr(ch);
    
    emit_semi();
    emit_newline();
    
    ch = skip_ws(ch);
    if (ch == 59) {
        ch = read_char();
    }
    
    return ch;
}

fn compile_if_body(ch, indent) {
    // 'if' already consumed, ch is first char after
    ch = skip_ws(ch);
    
    emit_indent(indent);
    emit_if_kw();
    emit_space();
    emit_lparen();
    
    ch = read_char();  // Skip '('
    ch = skip_ws(ch);
    ch = compile_expr(ch);
    
    emit_rparen();
    ch = skip_ws(ch);
    ch = read_char();  // Skip ')'
    ch = skip_ws(ch);
    
    emit_space();
    emit_lbrace();
    emit_newline();
    
    ch = read_char();  // Skip '{'
    ch = compile_block(ch, indent + 1);
    
    emit_indent(indent);
    emit_rbrace();
    
    ch = skip_ws(ch);
    if (ch == 101) {  // 'e' for 'else'
        ch = read_char();
        ch = read_char();
        ch = read_char();
        ch = read_char();
        ch = skip_ws(ch);
        
        emit_space();
        emit_else_kw();
        emit_space();
        emit_lbrace();
        emit_newline();
        
        ch = read_char();  // Skip '{'
        ch = compile_block(ch, indent + 1);
        
        emit_indent(indent);
        emit_rbrace();
    }
    
    emit_newline();
    return ch;
}

fn compile_while_body(ch, indent) {
    // 'while' already consumed, ch is first char after
    ch = skip_ws(ch);
    
    emit_indent(indent);
    emit_while_kw();
    emit_space();
    emit_lparen();
    
    ch = read_char();  // Skip '('
    ch = skip_ws(ch);
    ch = compile_expr(ch);
    
    emit_rparen();
    ch = skip_ws(ch);
    ch = read_char();  // Skip ')'
    ch = skip_ws(ch);
    
    emit_space();
    emit_lbrace();
    emit_newline();
    
    ch = read_char();  // Skip '{'
    ch = compile_block(ch, indent + 1);
    
    emit_indent(indent);
    emit_rbrace();
    emit_newline();
    
    return ch;
}

fn compile_return_body(ch, indent) {
    // 'return' already consumed, ch is first char after
    ch = skip_ws(ch);
    
    emit_indent(indent);
    emit_return_kw();
    emit_space();
    
    if (ch != 59) {
        ch = compile_expr(ch);
    } else {
        putchar(48);
    }
    
    emit_semi();
    emit_newline();
    
    ch = skip_ws(ch);
    if (ch == 59) {
        ch = read_char();
    }
    
    return ch;
}

fn compile_print_body(ch, indent) {
    // 'print' already consumed, ch is first char after
    ch = skip_ws(ch);
    ch = read_char();  // Skip '('
    ch = skip_ws(ch);
    
    // Simplified approach: handle each arg with separate printf
    while (ch != 41 && ch != 0 - 1) {  // ')' or EOF
        ch = skip_ws(ch);
        if (ch == 41) {
            ch = read_char();
            // Add newline at end
            emit_indent(indent);
            emit_printf();
            emit_lparen();
            emit_quote();
            putchar(92); putchar(110);  // \n
            emit_quote();
            emit_rparen();
            emit_semi();
            emit_newline();
            return ch;
        }
        
        emit_indent(indent);
        
        if (ch == 34) {  // String literal
            emit_printf();
            emit_lparen();
            emit_quote();
            ch = read_char();
            while (ch != 34 && ch != 0 - 1) {
                if (ch == 92) {  // Backslash
                    ch = read_char();
                    if (ch == 110) {
                        putchar(92); putchar(110);
                    } else if (ch == 116) {
                        putchar(92); putchar(116);
                    } else if (ch == 34) {
                        putchar(92); putchar(34);
                    } else if (ch == 92) {
                        putchar(92); putchar(92);
                    } else {
                        putchar(ch);
                    }
                } else {
                    putchar(ch);
                }
                ch = read_char();
            }
            ch = read_char();  // Skip closing "
            emit_quote();
            emit_rparen();
            emit_semi();
            emit_newline();
        } else {
            // Expression - printf("%lld", (long long)(expr))
            emit_printf();
            emit_lparen();
            emit_quote();
            putchar(37); putchar(108); putchar(108); putchar(100);  // %lld
            emit_quote();
            emit_comma();
            emit_space();
            emit_lparen();
            putchar(108); putchar(111); putchar(110); putchar(103);  // long
            emit_space();
            putchar(108); putchar(111); putchar(110); putchar(103);  // long
            emit_rparen();
            emit_lparen();
            ch = compile_expr(ch);
            emit_rparen();
            emit_rparen();
            emit_semi();
            emit_newline();
        }
        
        ch = skip_ws(ch);
        if (ch == 44) {
            ch = read_char();
            ch = skip_ws(ch);
        }
    }
    
    // Add newline at end of print
    emit_indent(indent);
    emit_printf();
    emit_lparen();
    emit_quote();
    putchar(92); putchar(110);  // \n
    emit_quote();
    emit_rparen();
    emit_semi();
    emit_newline();
    
    ch = read_char();  // Skip ')'
    ch = skip_ws(ch);
    if (ch == 59) {
        ch = read_char();
    }
    
    return ch;
}

fn compile_assign_or_call(ch, indent) {
    emit_indent(indent);
    
    // Read identifier
    while (is_alnum(ch)) {
        putchar(ch);
        ch = read_char();
    }
    
    ch = skip_ws(ch);
    
    if (ch == 61) {  // '=' assignment
        emit_space();
        emit_assign();
        emit_space();
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_expr(ch);
    } else if (ch == 40) {  // '(' call
        ch = compile_call_args(ch);
    }
    
    emit_semi();
    emit_newline();
    
    ch = skip_ws(ch);
    if (ch == 59) {
        ch = read_char();
    }
    
    return ch;
}

fn compile_call_args(ch) {
    emit_lparen();
    ch = read_char();
    ch = skip_ws(ch);
    
    let first = 1;
    while (ch != 41) {
        if (!first) {
            emit_comma();
            emit_space();
        }
        ch = compile_expr(ch);
        first = 0;
        ch = skip_ws(ch);
        if (ch == 44) {
            ch = read_char();
            ch = skip_ws(ch);
        }
    }
    
    emit_rparen();
    ch = read_char();
    
    return ch;
}

// ============================================================
// EXPRESSION COMPILER
// ============================================================

fn compile_expr(ch) {
    ch = skip_ws(ch);
    return compile_or(ch);
}

fn compile_or(ch) {
    ch = compile_and(ch);
    
    ch = skip_ws(ch);
    while (ch == 124) {
        let ch2 = read_char();
        if (ch2 == 124) {
            emit_space();
            putchar(124);
            putchar(124);
            emit_space();
            ch = read_char();
            ch = skip_ws(ch);
            ch = compile_and(ch);
            ch = skip_ws(ch);
        } else {
            putchar(ch);
            ch = ch2;
            return ch;
        }
    }
    
    return ch;
}

fn compile_and(ch) {
    ch = compile_eq(ch);
    
    ch = skip_ws(ch);
    while (ch == 38) {
        let ch2 = read_char();
        if (ch2 == 38) {
            emit_space();
            putchar(38);
            putchar(38);
            emit_space();
            ch = read_char();
            ch = skip_ws(ch);
            ch = compile_eq(ch);
            ch = skip_ws(ch);
        } else {
            putchar(ch);
            ch = ch2;
            return ch;
        }
    }
    
    return ch;
}

fn compile_eq(ch) {
    ch = compile_cmp(ch);
    
    ch = skip_ws(ch);
    while (ch == 61 || ch == 33) {
        let op = ch;
        let ch2 = read_char();
        
        if (op == 61 && ch2 == 61) {
            emit_space();
            putchar(61);
            putchar(61);
            emit_space();
            ch = read_char();
            ch = skip_ws(ch);
            ch = compile_cmp(ch);
            ch = skip_ws(ch);
        } else if (op == 33 && ch2 == 61) {
            emit_space();
            putchar(33);
            putchar(61);
            emit_space();
            ch = read_char();
            ch = skip_ws(ch);
            ch = compile_cmp(ch);
            ch = skip_ws(ch);
        } else {
            // Single = or ! - not part of equality
            if (op == 61) {
                // End of expression
                return ch;
            }
            putchar(op);
            ch = ch2;
            return ch;
        }
    }
    
    return ch;
}

fn compile_cmp(ch) {
    ch = compile_term(ch);
    
    ch = skip_ws(ch);
    while (ch == 60 || ch == 62) {
        let op = ch;
        let ch2 = read_char();
        
        emit_space();
        putchar(op);
        
        if (ch2 == 61) {
            putchar(61);
            ch = read_char();
        } else {
            ch = ch2;
        }
        
        emit_space();
        ch = skip_ws(ch);
        ch = compile_term(ch);
        ch = skip_ws(ch);
    }
    
    return ch;
}

fn compile_term(ch) {
    ch = compile_factor(ch);
    
    ch = skip_ws(ch);
    while (ch == 43 || ch == 45) {
        let op = ch;
        emit_space();
        putchar(op);
        emit_space();
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_factor(ch);
        ch = skip_ws(ch);
    }
    
    return ch;
}

fn compile_factor(ch) {
    ch = compile_unary(ch);
    
    ch = skip_ws(ch);
    while (ch == 42 || ch == 47 || ch == 37) {
        let op = ch;
        emit_space();
        putchar(op);
        emit_space();
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_unary(ch);
        ch = skip_ws(ch);
    }
    
    return ch;
}

fn compile_unary(ch) {
    ch = skip_ws(ch);
    
    if (ch == 45) {
        putchar(45);
        ch = read_char();
        return compile_unary(ch);
    }
    
    if (ch == 33) {
        putchar(33);
        ch = read_char();
        return compile_unary(ch);
    }
    
    return compile_primary(ch);
}

fn compile_primary(ch) {
    ch = skip_ws(ch);
    
    // Number
    if (is_digit(ch)) {
        while (is_digit(ch)) {
            putchar(ch);
            ch = read_char();
        }
        return ch;
    }
    
    // Parenthesized
    if (ch == 40) {
        emit_lparen();
        ch = read_char();
        ch = skip_ws(ch);
        ch = compile_expr(ch);
        ch = skip_ws(ch);
        emit_rparen();
        ch = read_char();
        return ch;
    }
    
    // Identifier or keyword
    if (is_alpha(ch)) {
        let c0 = ch;
        ch = read_char();
        
        // Check for 'true'
        if (c0 == 116 && ch == 114) {
            ch = read_char();
            ch = read_char();
            ch = read_char();
            putchar(49);
            return ch;
        }
        
        // Check for 'false'
        if (c0 == 102 && ch == 97) {
            ch = read_char();
            ch = read_char();
            ch = read_char();
            ch = read_char();
            putchar(48);
            return ch;
        }
        
        // Check for 'putchar'
        if (c0 == 112 && ch == 117) {
            ch = read_char();
            ch = read_char();
            ch = read_char();
            ch = read_char();
            ch = read_char();
            ch = skip_ws(ch);
            emit_toy_putchar();
            ch = compile_call_args(ch);
            return ch;
        }
        
        // Check for 'getchar'
        if (c0 == 103 && ch == 101) {
            ch = read_char();
            ch = read_char();
            ch = read_char();
            ch = read_char();
            ch = read_char();
            ch = skip_ws(ch);
            emit_toy_getchar();
            emit_lparen();
            emit_rparen();
            ch = read_char();
            ch = read_char();
            return ch;
        }
        
        // Regular identifier - buffer it first
        let id0 = c0;
        let id1 = 0; let id2 = 0; let id3 = 0; let id4 = 0;
        let id5 = 0; let id6 = 0; let id7 = 0; let id8 = 0;
        let id9 = 0; let id10 = 0; let id11 = 0; let id12 = 0;
        let id_len = 1;
        
        if (is_alnum(ch)) { id1 = ch; id_len = 2; ch = read_char(); }
        if (is_alnum(ch)) { id2 = ch; id_len = 3; ch = read_char(); }
        if (is_alnum(ch)) { id3 = ch; id_len = 4; ch = read_char(); }
        if (is_alnum(ch)) { id4 = ch; id_len = 5; ch = read_char(); }
        if (is_alnum(ch)) { id5 = ch; id_len = 6; ch = read_char(); }
        if (is_alnum(ch)) { id6 = ch; id_len = 7; ch = read_char(); }
        if (is_alnum(ch)) { id7 = ch; id_len = 8; ch = read_char(); }
        if (is_alnum(ch)) { id8 = ch; id_len = 9; ch = read_char(); }
        if (is_alnum(ch)) { id9 = ch; id_len = 10; ch = read_char(); }
        if (is_alnum(ch)) { id10 = ch; id_len = 11; ch = read_char(); }
        if (is_alnum(ch)) { id11 = ch; id_len = 12; ch = read_char(); }
        if (is_alnum(ch)) { id12 = ch; id_len = 13; ch = read_char(); }
        while (is_alnum(ch)) { ch = read_char(); }  // Skip excess
        
        ch = skip_ws(ch);
        
        // Add fn_ prefix if function call
        if (ch == 40) {
            emit_fn_prefix();
        }
        
        // Output identifier
        putchar(id0);
        if (id_len >= 2) { putchar(id1); }
        if (id_len >= 3) { putchar(id2); }
        if (id_len >= 4) { putchar(id3); }
        if (id_len >= 5) { putchar(id4); }
        if (id_len >= 6) { putchar(id5); }
        if (id_len >= 7) { putchar(id6); }
        if (id_len >= 8) { putchar(id7); }
        if (id_len >= 9) { putchar(id8); }
        if (id_len >= 10) { putchar(id9); }
        if (id_len >= 11) { putchar(id10); }
        if (id_len >= 12) { putchar(id11); }
        if (id_len >= 13) { putchar(id12); }
        
        if (ch == 40) {
            ch = compile_call_args(ch);
        }
        
        return ch;
    }
    
    return ch;
}

// ============================================================
// MAIN
// ============================================================

fn main() {
    let ch = read_char();
    return compile_program(ch);
}
